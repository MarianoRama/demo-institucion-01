---
import Layout from '../layouts/Layout.astro';
import Visit from './Visit.astro';
import Carousel from './Carousel.astro';
import {pathFor,withBase,type Locale} from '../i18n/ui';
import photosManifest from '../data/photos.json';
const {locale='es',page}=Astro.props as {locale:Locale,page:'nosotros'|'propuesta-educativa'|'actividades'|'galeria'};const en=locale==='en';const p=(s:string)=>pathFor(locale,s);
const toSlides=(filenames:string[])=>filenames.map((f)=>(f.startsWith('sample-')?'SAMPLE:':'')+'/images/'+f);
const content={
 'nosotros':en?['About us','A school. A community. A place to belong.','We share childhood’s discoveries, learning and experiences.']:['Nosotros','Un colegio. Una comunidad. Un lugar para crecer.','Compartimos los descubrimientos, los aprendizajes y las experiencias de la infancia.'],
 'propuesta-educativa':en?['Our program','Two languages, throughout the journey.','Nursery, early years and primary education: a bilingual program that grows with each stage of childhood.']:['Propuesta educativa','Dos idiomas, a lo largo de todo el camino.','Maternal, Inicial y Primaria: una propuesta bilingüe que acompaña cada etapa de la infancia.'],
 'actividades':en?['School life','Discover what moves us.','Technology, art, shared adventures and theatre. Different ways to learn, express ourselves and work together.']:['Vida en el colegio','Descubrir lo que nos mueve.','Tecnología, arte, experiencias compartidas y teatro. Distintas formas de aprender, expresarnos y trabajar juntos.'],
 'galeria':en?['Gallery','Small moments. Shared memories.','A glimpse of our school community, its outings and celebrations.']:['Galería','Pequeños momentos. Grandes recuerdos.','Una mirada a nuestra comunidad, sus paseos y sus encuentros.']
}[page];
const levels=en?[
['maternal','Nursery','Learning begins with connection.','Play, care and exploration are at the heart of those first experiences at school.','Play and discovery','First connections','sample-maternal.jpg'],['inicial','Early years','Curiosity becomes learning.','Space to explore, express ideas and discover English and Spanish through everyday experiences.','Expression and creativity','Growing together','sample-inicial.jpg'],['primaria','Primary','Growing in knowledge and independence.','A bilingual journey that brings together learning, projects and shared experiences.','Knowledge and projects','Independence and cooperation','sample-primaria.jpg']
]:[
['maternal','Maternal','Aprender empieza por el vínculo.','El juego, el cuidado y la exploración son el centro de los primeros encuentros con el colegio.','Juego y descubrimiento','Primeros vínculos','sample-maternal.jpg'],['inicial','Inicial','La curiosidad se transforma en aprendizaje.','Un espacio para explorar, expresar ideas y descubrir el inglés y el español en las experiencias de cada día.','Expresión y creatividad','Crecer en compañía','sample-inicial.jpg'],['primaria','Primaria','Crecer en conocimiento y autonomía.','Un recorrido bilingüe que integra aprendizajes, proyectos y experiencias compartidas.','Conocimiento y proyectos','Autonomía y cooperación','sample-primaria.jpg']];
const activities=en?[
['Technology & robotics','Ideas to build and problems to solve. An invitation to explore technology through projects.',toSlides(photosManifest.robotica)],['Art & creativity','Colours, textures and different materials. Room for imagination and personal expression.',toSlides(photosManifest.arte)],['Trips & camps','Shared experiences beyond the classroom: discovering new places and learning with others.',toSlides(photosManifest.salidas)]
]:[
['Tecnología y robótica','Ideas para construir y problemas para resolver. Una invitación a explorar la tecnología a través de proyectos.',toSlides(photosManifest.robotica)],['Arte y creatividad','Colores, texturas y distintos materiales. Un espacio para la imaginación y la expresión personal.',toSlides(photosManifest.arte)],['Salidas y campamentos','Experiencias compartidas fuera del aula: descubrir nuevos lugares y aprender junto a otros.',toSlides(photosManifest.salidas)]
];
const photos=photosManifest.galeria.map((src)=>({src,title:en?'Sample photo':'Foto de muestra',alt:en?'Stock sample photo, to be replaced':'Foto de stock de muestra, a reemplazar',width:1440,height:1440}));
---
<Layout title={content[0]} description={content[2]} locale={locale}>
<section class="page-intro"><div class="container"><nav class="breadcrumb" aria-label={en?'Breadcrumb':'Ruta de navegación'}><a href={p('/')}>{en?'Home':'Inicio'}</a><span aria-hidden="true">/</span><span aria-current="page">{content[0]}</span></nav><div class="stack"><span class="eyebrow">{content[0]}</span><h1>{content[1]}</h1><p class="lead">{content[2]}</p></div></div></section>
{page==='nosotros'&&<>
<section class="section"><div class="container story-grid"><div class="photo story-photo"><img src={withBase('/images/sample-general-1.jpg')} alt={en?'Stock sample photo, to be replaced':'Foto de stock de muestra, a reemplazar'} width="1555" height="849"/><span class="sample-badge">{en?'Sample photo':'Foto de muestra'}</span></div><div class="stack"><span class="eyebrow">{en?'Rooted in our community':'Con raíces en la comunidad'}</span><h2>{en?'Growing together, in two languages.':'Crecer juntos, en dos idiomas.'}</h2><p class="lead">{en?'[Nombre de la institución] brings together nursery, early years and primary education in a full-day bilingual program.':'El [Nombre de la institución] reúne Maternal, Inicial y Primaria en una propuesta bilingüe de doble horario.'}</p><p class="lead">{en?'A secular school where learning also means sharing, listening and finding new ways to understand the world.':'Una institución laica donde aprender también significa compartir, escuchar y encontrar nuevas formas de comprender el mundo.'}</p><div><a class="text-link" href={p('/propuesta-educativa/')}>{en?'Explore our program':'Explorá nuestra propuesta'} ↗</a></div></div></div></section>
<section class="section section--alt"><div class="container"><div class="section-heading"><div class="stack"><span class="eyebrow">{en?'What brings us together':'Lo que nos une'}</span><h2>{en?'Learning is also learning to live together.':'Aprender también es aprender a convivir.'}</h2></div></div><div class="grid grid--3">{(en?[['01','Curiosity','Asking questions, exploring and enjoying each new discovery.'],['02','Respect','Listening to others and valuing different ways of seeing the world.'],['03','Community','Sharing experiences that connect students, teachers and families.']]:[['01','Curiosidad','Hacer preguntas, explorar y disfrutar de cada nuevo descubrimiento.'],['02','Respeto','Escuchar a otros y valorar distintas formas de ver el mundo.'],['03','Comunidad','Compartir experiencias que unen a alumnos, docentes y familias.']]).map(([n,title,text])=><article class="value-card stack"><span class="number">{n}</span><h3>{title}</h3><p class="lead">{text}</p></article>)}</div></div></section>
</>}
{page==='propuesta-educativa'&&<>
<section class="section"><div class="container"><div class="program-summary"><span class="eyebrow">{en?'The experience':'La experiencia'}</span><p>{en?'English and Spanish. Learning, play and projects. A full-day program to discover together.':'Inglés y español. Aprendizajes, juego y proyectos. Una propuesta de doble horario para descubrir juntos.'}</p></div><div class="levels-jump" aria-label={en?'Education levels':'Niveles educativos'}>{levels.map(([id,title])=><a href={'#'+id}>{title}<span aria-hidden="true">↓</span></a>)}</div>{levels.map(([id,title,headline,text,one,two,img],i)=><article id={id} class="level-detail"><div class="photo level-photo"><img src={withBase('/images/'+img)} alt={en?`Illustrative stock image for ${title}`:`Imagen ilustrativa de muestra para ${title}`} width="900" height="650" loading="lazy"/><span class="sample-badge">{en?'Sample photo':'Foto de muestra'}</span></div><div class="stack"><span class="eyebrow">0{i+1} / {title}</span><h2>{headline}</h2><p class="lead">{text}</p><ul class="learning-tags"><li>{one}</li><li>{two}</li></ul><div><a class="text-link" href={p('/admisiones/')}>{en?`Enquire about ${title}`:`Consultar por ${title}`} ↗</a></div></div></article>)}</div></section>
<div class="container program-note"><p>{en?'Ask the school about ages, schedules and availability for each level.':'Consultá con el colegio las edades de ingreso, los horarios y la disponibilidad de cada nivel.'}</p><a href={p('/contacto/')}>{en?'Contact the school':'Contactar al colegio'} ↗</a></div>
</>}
{page==='actividades'&&<>
<section class="section"><div class="container activities">{activities.map(([title,text,slides],i)=><article id={'actividad-'+(i+1)} class="activity-detail"><div class="activity-media"><Carousel slides={slides as string[]} label={title as string} ratio="4 / 3"/></div><div class="stack"><span class="eyebrow">0{i+1} / {en?'Explore & learn':'Explorar y aprender'}</span><h2>{title}</h2><p class="lead">{text}</p></div></article>)}<article id="actividad-4" class="theatre-block"><div class="stack theatre-heading"><span class="eyebrow">04 / {en?'A year of stories':'Un año de historias'}</span><h2>{en?'Theatre, every year':'Teatro, todos los años'}</h2><p class="lead">{en?'Each year, different groups prepare plays on different themes. A shared experience that brings stories to life on stage.':'Cada año, los distintos grupos preparan obras de teatro sobre diferentes temas. Una experiencia compartida que lleva las historias al escenario.'}</p><div><span class="text-link">{en?'Social links to be confirmed':'Redes a confirmar'}</span></div></div><div class="theatre-video" data-theatre-sequence><video src={withBase('/videos/teatro-telon.mp4')} autoplay muted loop playsinline aria-label={en?'Theater curtain opening':'Telón de teatro abriéndose'} data-seq-video></video><img src={withBase('/images/sample-general-3.jpg')} alt={en?'A moment from a school play':'Un momento de una obra de teatro'} data-seq-photo/><span class="sample-badge">{en?'Sample':'Muestra'}</span></div></article></div></section>
</>}
{page==='galeria'&&<section class="section"><div class="container"><div class="gallery-grid">{photos.map((f,i)=><figure class="gallery-item"><a href={withBase('/images/'+f.src)} target="_blank" rel="noopener" aria-label={en?`Open full photo: ${f.title}`:`Abrir foto completa: ${f.title}`}><img src={withBase('/images/'+f.src)} alt={f.alt} loading={i===0?'eager':'lazy'}/><span class="sample-badge">{en?'Sample photo':'Foto de muestra'}</span><span class="expand" aria-hidden="true">↗</span></a><figcaption><span>0{i+1}</span>{f.title}</figcaption></figure>)}</div><div class="gallery-end"><p class="lead">{en?'More moments from our school community.':'Más momentos de nuestra comunidad.'}</p><span class="btn btn--outline">{en?'Social links to be confirmed':'Redes a confirmar'}</span></div></div></section>}
<Visit locale={locale}/>
</Layout>
<style>
.story-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:65px;align-items:center}.story-photo{height:470px;border-top-left-radius:100px}.value-card{padding:15px 30px 15px 0;border-top:1px solid var(--border)}.value-card .lead{font-size:15px}.program-summary{display:grid;grid-template-columns:1fr 2fr;gap:40px;align-items:start;margin-bottom:45px}.program-summary p{font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.35;letter-spacing:-.02em}.program-summary .eyebrow{padding-top:10px}.levels-jump{display:flex;gap:16px;padding-bottom:20px;border-bottom:1px solid var(--border)}.levels-jump a{font-size:13px;display:flex;gap:40px;padding:15px 20px;border:1px solid var(--border);border-radius:6px}.levels-jump a:hover{background:var(--cream-2)}.level-detail{display:grid;grid-template-columns:1fr 1fr;gap:75px;align-items:center;padding:60px 0;border-bottom:1px solid var(--border);scroll-margin-top:110px}.level-detail:nth-of-type(even) .level-photo{order:2}.level-photo{height:350px}.learning-tags{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}.learning-tags li{padding:9px 12px;border:1px solid var(--border);border-radius:30px;font-size:11px}.program-note{display:flex;justify-content:space-between;gap:30px;padding:26px 0 60px;font-size:13px;color:var(--ink-soft)}.program-note a{text-decoration:underline;flex-shrink:0}.activities{display:flex;flex-direction:column;gap:75px}.activity-detail{display:grid;grid-template-columns:1.1fr 1fr;gap:70px;align-items:center;scroll-margin-top:110px}.activity-detail:nth-child(even) .activity-media{order:2}.activity-media{min-width:0}.theatre-block{scroll-margin-top:110px}.theatre-heading{max-width:640px;margin:0 auto 32px auto;text-align:center;align-items:center}.theatre-heading .lead{max-width:520px}.theatre-video{position:relative;width:100%;max-width:1160px;margin:0 auto;border-radius:20px;overflow:hidden;aspect-ratio:16/9;background:var(--accent-dark)}.theatre-video video,.theatre-video img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;opacity:0;transition:opacity 1.1s ease}.theatre-video video[data-active],.theatre-video img[data-active]{opacity:1}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.gallery-item{margin:0;min-width:0}.gallery-item a{display:block;position:relative;border-radius:14px;overflow:hidden;background:var(--cream-2);aspect-ratio:4/3}.gallery-item img{width:100%;height:100%;object-fit:cover;transition:transform .4s}.gallery-item a:hover img{transform:scale(1.025)}.expand{position:absolute;right:16px;bottom:16px;background:var(--cream);padding:10px 15px;border-radius:50%;font-size:18px}.gallery-item figcaption{display:flex;gap:18px;align-items:center;padding-top:14px;font-family:var(--font-display);font-size:22px}.gallery-item figcaption>span{font-family:var(--font-sans);font-size:10px;color:var(--muted)}.gallery-end{display:flex;justify-content:space-between;gap:24px;align-items:center;border-top:1px solid var(--border);margin-top:55px;padding-top:30px}
@media(max-width:900px){.story-grid,.level-detail,.activity-detail{gap:35px}.story-photo{height:400px}}@media(max-width:700px){.story-grid,.level-detail,.activity-detail,.program-summary{grid-template-columns:1fr}.story-photo{height:330px}.program-summary{gap:20px}.level-detail{padding:38px 0}.level-detail:nth-of-type(even) .level-photo,.activity-detail:nth-child(even) .activity-media{order:0}.levels-jump{gap:8px}.levels-jump a{padding:12px;gap:16px;font-size:12px}.level-photo{height:280px}.program-note{flex-direction:column;gap:15px}.activities{gap:55px}.gallery-grid{gap:16px;grid-template-columns:repeat(2,1fr)}.gallery-end{flex-direction:column;align-items:start}.theatre-video{border-radius:14px}}
</style>
<script>
  function initTheatreSequence() {
    document.querySelectorAll('[data-theatre-sequence]').forEach((box) => {
      if ((box as HTMLElement).dataset.initialized) return;
      (box as HTMLElement).dataset.initialized = 'true';
      const video = box.querySelector('[data-seq-video]') as HTMLVideoElement | null;
      const photo = box.querySelector('[data-seq-photo]') as HTMLElement | null;
      if (!video || !photo) return;
      video.setAttribute('data-active', '');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reducedMotion.matches) return;
      let showingVideo = true;
      function next() {
        showingVideo = !showingVideo;
        if (showingVideo) {
          photo.removeAttribute('data-active');
          video.setAttribute('data-active', '');
        } else {
          video.removeAttribute('data-active');
          photo.setAttribute('data-active', '');
        }
        setTimeout(next, showingVideo ? 6000 : 4000);
      }
      setTimeout(next, 6000);
    });
  }
  document.addEventListener('astro:page-load', initTheatreSequence);
  initTheatreSequence();
</script>


