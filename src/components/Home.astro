---
import Layout from '../layouts/Layout.astro';
import Visit from './Visit.astro';
import {pathFor,withBase,type Locale} from '../i18n/ui';
const {locale='es'}=Astro.props as {locale:Locale};const en=locale==='en';const p=(s:string)=>pathFor(locale,s);
const levels=en?[
['01','Nursery','A first world to discover.','Learning through play, care and those first connections.','maternal'],['02','Early years','Curiosity leads the way.','Exploring, creating and growing together in two languages.','inicial'],['03','Primary','More questions. More possibilities.','Knowledge, independence and English as part of everyday learning.','primaria']
]:[['01','Maternal','Un mundo por descubrir.','Aprender desde el juego, el cuidado y los primeros vínculos.','maternal'],['02','Inicial','La curiosidad marca el camino.','Explorar, crear y crecer junto a otros, en dos idiomas.','inicial'],['03','Primaria','Más preguntas. Más posibilidades.','Conocimiento, autonomía e inglés como parte del aprendizaje cotidiano.','primaria']];
const activities=en?[['01','Technology & robotics','Ideas that become projects.'],['02','Art & creativity','Many ways to express ourselves.'],['03','Trips & camps','The world is a place to learn.'],['04','Theatre','Stories that come alive on stage.']]:[['01','Tecnología y robótica','Ideas que se convierten en proyectos.'],['02','Arte y creatividad','Muchas formas de expresarnos.'],['03','Salidas y campamentos','El mundo también es un aula.'],['04','Teatro','Historias que cobran vida en escena.']];
---
<Layout title={en?'Home':'Inicio'} description={en?'A place to grow in two languages. Discover [Nombre de la institución]: nursery, early years and primary education.':'Un lugar para crecer en dos idiomas. Conocé el [Nombre de la institución]: Maternal, Inicial y Primaria.'} locale={locale}>
<div class="hero-zone">
<div class="hero-diagonal" aria-hidden="true"></div>
<section class="home-hero">
<div class="container hero-grid">
<div class="hero-copy stack">
<span class="eyebrow"><span class="little-line"></span>{en?'Bilingual education':'Educación bilingüe'}</span>
<h1>{en?'A place to grow.':'Un lugar para crecer.'}<em>{en?'A world to discover.':'Un mundo por descubrir.'}</em></h1>
<p class="lead">{en?'Learning in two languages. Growing with others. A school that is part of childhood, from the very first steps.':'Aprender en dos idiomas. Crecer junto a otros. Un colegio que acompaña la infancia, desde los primeros pasos.'}</p>
<div class="actions"><a class="btn btn--primary btn--pill" href={p('/propuesta-educativa/')}>{en?'Our program':'Sobre nosotros'}</a><a class="hero-secondary" href={p('/contacto/')}>{en?'Let’s talk':'Hablemos'} <span aria-hidden="true">→</span></a></div>
<div class="hero-note"><span aria-hidden="true">✳</span><p>{en?'Nursery · Early years · Primary':'Maternal · Inicial · Primaria'}<small>{en?'Two languages. Shared experiences.':'Dos idiomas. Muchas experiencias compartidas.'}</small></p></div>
</div>
<div class="hero-visual">
<div class="hero-photo"><img src={withBase('/images/sample-general-1.jpg')} alt={en?'Stock sample photo, to be replaced':'Foto de stock de muestra, a reemplazar'} width="1555" height="849" fetchpriority="high"/><span class="sample-badge">{en?'Sample photo':'Foto de muestra'}</span><div class="photo-caption"><span class="photo-dot"></span>{en?'Our school. Our community.':'Nuestro colegio. Nuestra comunidad.'}</div></div>
<div class="floating-note"><span>Hello!</span><strong>¡Hola!</strong><small>{en?'Two languages, every day.':'Dos idiomas, todos los días.'}</small></div>
<svg class="hero-seal" viewBox="0 0 140 140" aria-hidden="true">
<path id="sealCircle" fill="none" d="M 70,70 m -54,0 a 54,54 0 1,1 108,0 a 54,54 0 1,1 -108,0" />
<circle cx="70" cy="70" r="40" class="seal-fill" />
<text font-size="11.3" letter-spacing="2" class="seal-text"><textPath href="#sealCircle" startOffset="0">· {en?'BILINGUAL':'BILINGÜE'} · {en?'TWO LANGUAGES':'DOS IDIOMAS'} </textPath></text>
<text x="70" y="66" text-anchor="middle" class="seal-mark">✳</text>
<text x="70" y="82" text-anchor="middle" class="seal-sub">{en?'SINCE DAY 1':'DESDE SIEMPRE'}</text>
</svg>
</div>
</div>
</section>
<div class="values-strip"><div class="container"><span>{en?'Bilingual education':'Educación bilingüe'}</span><i aria-hidden="true">✳</i><span>{en?'Full-day learning':'Doble horario'}</span><i aria-hidden="true">✳</i><span>{en?'Learning together':'Aprender en comunidad'}</span><i aria-hidden="true">✳</i><span>{en?'Rooted in our community':'Con raíces en la comunidad'}</span></div></div>
<div class="container levels-intro"><div class="section-heading"><div class="stack"><span class="eyebrow">{en?'A journey, three stages':'Un camino, tres etapas'}</span><h2>{en?'Every stage has its own discoveries.':'Cada etapa tiene sus propios descubrimientos.'}</h2></div><a class="text-link" href={p('/propuesta-educativa/')}>{en?'Explore the levels':'Explorá los niveles'} <span aria-hidden="true">↗</span></a></div></div>
</div>
<section class="section levels-section"><div class="container"><div class="grid grid--3 levels">{levels.map(([n,title,headline,text,id])=><a class="level-card" href={p('/propuesta-educativa/')+'#'+id}><div class="level-top"><span>{n} /</span><span class:list={['level-symbol',id]} aria-hidden="true">{id==='maternal'?'◒':id==='inicial'?'✳':'↗'}</span></div><h3>{title}</h3><strong>{headline}</strong><p>{text}</p><span class="level-link">{en?'Discover more':'Conocer más'} <span aria-hidden="true">↗</span></span></a>)}</div></div></section>
<section class="section section--alt"><div class="container about-grid"><div class="about-photo photo"><img src={withBase('/images/sample-general-2.jpg')} alt={en?'Stock sample photo, to be replaced':'Foto de stock de muestra, a reemplazar'} width="1440" height="1440" loading="lazy"/><span class="sample-badge">{en?'Sample photo':'Foto de muestra'}</span><span class="image-tag">{en?'Learning beyond the classroom':'Aprender también es salir a descubrir'}</span></div><div class="stack about-copy"><span class="eyebrow">{en?'Our way of learning':'Nuestra forma de aprender'}</span><h2>{en?'Two languages. A thousand ways to connect.':'Dos idiomas. Mil formas de conectar.'}</h2><p class="lead">{en?'English and Spanish are part of a shared educational journey. Play, projects and time together bring learning to life.':'El inglés y el español son parte de un mismo recorrido educativo. El juego, los proyectos y la convivencia hacen que aprender sea una experiencia compartida.'}</p><div class="principle"><span>01</span><div><h3>{en?'Learn by doing':'Aprender haciendo'}</h3><p>{en?'Explore, try, ask and discover.':'Explorar, probar, preguntar y descubrir.'}</p></div></div><div class="principle"><span>02</span><div><h3>{en?'Grow with others':'Crecer con otros'}</h3><p>{en?'Make room for listening, respect and cooperation.':'Hacer lugar a la escucha, el respeto y la cooperación.'}</p></div></div><div><a class="text-link" href={p('/nosotros/')}>{en?'Get to know our school':'Conocé el colegio'} <span aria-hidden="true">↗</span></a></div></div></div></section>
<section class="section"><div class="container life-grid"><div class="stack"><span class="eyebrow">{en?'School life':'La vida en el colegio'}</span><h2>{en?'Learning goes beyond the classroom.':'Lo que aprendemos va más allá del aula.'}</h2><p class="lead">{en?'Space to create, explore and discover what we enjoy.':'Espacios para crear, explorar y descubrir lo que nos gusta.'}</p><div><a class="text-link" href={p('/actividades/')}>{en?'See our activities':'Ver las actividades'} <span aria-hidden="true">↗</span></a></div></div><div class="activity-list">{activities.map(([n,title,text],i)=><a href={p('/actividades/')+'#actividad-'+(i+1)}><span>{n}</span><div><h3>{title}</h3><p>{text}</p></div><b aria-hidden="true">↗</b></a>)}</div></div></section>
<Visit locale={locale}/>
</Layout>
<style>
.hero-zone{position:relative}
.hero-diagonal{position:absolute;inset:0;z-index:0;background:var(--accent);clip-path:polygon(22% 0,100% 0,100% 100%,0 100%,0 12%)}
.home-hero{position:relative;z-index:1;padding:76px 0 60px}
.levels-intro{position:relative;z-index:1;padding:0 0 64px 0}
.levels-intro .eyebrow{color:var(--accent-light)}
.levels-intro h2{color:var(--cream)}
.levels-intro .text-link{color:var(--cream)}
.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1fr;gap:68px;align-items:center}
.hero-copy{gap:24px}
.hero-copy h1{font-size:clamp(3.4rem,5.6vw,5rem);line-height:.98;letter-spacing:-.03em;color:var(--cream)}
.hero-copy h1 em{display:block;font-style:normal;font-weight:400;font-size:clamp(1.35rem,2vw,1.65rem);letter-spacing:-.005em;color:var(--accent-light);margin-top:16px;line-height:1.35;max-width:430px}
.hero-copy .lead{max-width:440px;font-size:15px;color:#f1dfe0}
.hero-copy .eyebrow{display:flex;align-items:center;gap:10px;font-size:10px;color:var(--accent-light)}
.little-line{width:22px;height:1px;background:var(--accent-light)}
.btn--pill{border-radius:999px;padding:16px 32px;background:var(--cream);color:var(--accent-dark)}
.btn--pill:hover{background:var(--accent-light)}
.hero-secondary{font-size:13px;font-weight:600;padding:16px;color:var(--cream)}
.hero-secondary span{margin-left:14px}
.hero-note{display:flex;gap:14px;align-items:center;margin-top:6px}
.hero-note>span{font-size:36px;color:var(--accent-light)}
.hero-note p{font-size:11px;font-weight:600;color:var(--cream)}
.hero-note small{display:block;font-size:10px;color:#e2c9cb;font-weight:400;margin-top:2px}
.hero-visual{position:relative;padding:20px 34px 40px 6px}
.hero-photo{height:480px;position:relative;overflow:hidden;border-radius:130px 14px 14px 14px;background:var(--cream-2)}
.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:45% 50%}
.photo-caption{position:absolute;bottom:0;left:0;right:0;padding:42px 22px 20px;background:linear-gradient(transparent,#241920b3);color:#fff;font-size:10px;display:flex;align-items:center;gap:8px}
.photo-dot{width:5px;height:5px;border-radius:50%;background:#fff}
.floating-note{position:absolute;left:-30px;top:44px;background:#ecebdc;padding:19px 23px;border-radius:10px;transform:rotate(-7deg);box-shadow:0 6px 20px #38201712;z-index:2}
.floating-note span,.floating-note strong{display:block;font-family:var(--font-display);font-size:30px;font-weight:400;line-height:1.05}
.floating-note span{color:var(--accent)}
.floating-note small{display:block;font-size:8px;margin-top:10px}
.hero-seal{position:absolute;right:-6px;bottom:6px;width:118px;height:118px;animation:spin 22s linear infinite;z-index:2}
.seal-fill{fill:var(--accent)}
.seal-text{fill:var(--cream)}
.seal-mark{font-size:26px;fill:var(--cream);font-family:var(--font-display)}
.seal-sub{font-size:7px;fill:var(--accent-light);letter-spacing:.1em;font-family:var(--font-sans)}
@keyframes spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.hero-seal{animation:none}}
.values-strip{position:relative;z-index:1;border-block:1px solid rgba(250,248,242,.2);padding:25px 0}.values-strip .container{display:flex;align-items:center;justify-content:space-between;gap:20px}.values-strip span{font-size:12px;color:var(--cream)}.values-strip i{font-size:22px;color:var(--accent-light);font-style:normal}.level-card{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:14px;padding:28px;background:#f1ede4;transition:transform .2s,box-shadow .2s}.level-card:nth-child(2){background:#e8ecdf}.level-card:nth-child(3){background:#f3e5df}.level-card:hover{transform:translateY(-5px);box-shadow:0 12px 25px #4218290b}.level-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:30px}.level-top>span:first-child{font-size:10px;color:var(--muted)}.level-symbol{font-size:51px;color:var(--accent);line-height:1}.inicial{color:#627052}.primaria{color:#ae644b}.level-card h3{font-size:32px;margin-bottom:12px}.level-card strong{font-size:13px;font-weight:500;margin-bottom:8px}.level-card p{font-size:13px;color:var(--ink-soft);max-width:270px;margin-bottom:28px}.level-link{display:flex;justify-content:space-between;border-top:1px solid #302c2926;padding-top:18px;margin-top:auto;font-size:11px;font-weight:700}.levels-section{padding-top:0}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:88px;align-items:center}.about-photo{height:530px;border-radius:14px 14px 120px 14px}.image-tag{position:absolute;left:18px;bottom:20px;right:18px;width:fit-content;background:var(--cream);padding:11px 14px;font-size:10px;border-radius:4px}.about-copy{gap:25px}.principle{display:flex;gap:20px;align-items:start;padding-top:18px;border-top:1px solid var(--border)}.principle>span{font-size:11px;color:var(--accent);padding-top:5px}.principle h3{font-size:20px;margin-bottom:5px}.principle p{font-size:13px;color:var(--ink-soft)}.life-grid{display:grid;grid-template-columns:.9fr 1fr;gap:100px}.activity-list>a{display:flex;gap:20px;align-items:center;padding:24px 0;border-bottom:1px solid var(--border)}.activity-list>a:first-child{border-top:1px solid var(--border)}.activity-list>a>span{font-size:10px;color:var(--accent)}.activity-list h3{font-size:23px}.activity-list p{font-size:12px;color:var(--muted);margin-top:6px}.activity-list b{margin-left:auto;font-size:20px;font-weight:400}.activity-list a:hover h3{color:var(--accent)}
@media(min-width:1450px){.hero-photo{height:560px}}@media(max-width:1100px){.hero-grid{gap:40px}.hero-photo{height:460px}.hero-copy h1{font-size:clamp(2.8rem,5vw,3.8rem)}.about-grid,.life-grid{gap:45px}}@media(max-width:760px){.home-hero{padding:44px 0 40px}.hero-grid{grid-template-columns:1fr;gap:34px}.hero-copy h1{font-size:clamp(2.6rem,10vw,3.6rem)}.hero-copy h1 em{max-width:100%}.hero-copy{gap:22px}.hero-copy .lead{max-width:500px}.hero-visual{margin-left:14px;margin-right:14px;padding:18px 18px 30px 0}.hero-photo{height:340px;border-top-left-radius:90px}.floating-note{top:26px;left:-14px;padding:14px 17px}.floating-note span,.floating-note strong{font-size:22px}.hero-seal{width:92px;height:92px;right:-4px;bottom:0}.hero-note{margin-top:0}.values-strip .container{display:grid;grid-template-columns:1fr 1fr;gap:20px}.values-strip i{display:none}.values-strip span{font-size:11px}.about-grid,.life-grid{grid-template-columns:1fr;gap:32px}.about-photo{height:380px}.level-card{padding:24px}.level-top{margin-bottom:20px}.level-card p{max-width:none}.hero-note small{font-size:11px}}
</style>

